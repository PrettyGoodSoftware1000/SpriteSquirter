# Normalize line endings for text files
* text=auto eol=lf

# Godot text resources
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf

# Binary assets (consider Git LFS for these once real art arrives)
*.png binary
*.jpg binary
*.glb binary
*.blend binary
*.wav binary
*.ogg binary
